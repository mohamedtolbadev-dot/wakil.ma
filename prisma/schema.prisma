generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  password          String?
  phone             String?
  storeName         String
  plan              Plan               @default(FREE)
  planExpiresAt     DateTime?
  role              UserRole           @default(USER)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  googleId          String?            @unique(map: "googleId")
  agent             Agent?
  products          Product[]
  conversations     Conversation[]
  customers         Customer[]
  notifications     Notification[]
  orders            Order[]
  invoices          Invoice[]
  monthlyUsage      MonthlyUsage[]
  campaigns         Campaign[]
  campaignTemplates CampaignTemplate[]
  blogPosts         BlogPost[]

  @@map("users")
}

model MonthlyUsage {
  id             String   @id @default(cuid())
  userId         String
  month          String // format: "YYYY-MM" (e.g. "2026-04")
  conversations  Int      @default(0)
  aiReplies      Int      @default(0)
  aiTokensInput  Int      @default(0)
  aiTokensOutput Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, month])
  @@map("monthly_usage")
}

model VerificationToken {
  id        String   @id @default(cuid())
  phone     String
  code      String
  data      String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

model Agent {
  id                  String   @id @default(cuid())
  userId              String   @unique
  name                String   @default("Agent")
  domain              String   @default("تجارة عامة")
  style               String   @default("friendly")
  language            String   @default("darija")
  isActive            Boolean  @default(true)
  instructions        String?  @db.Text
  productInstructions String?  @db.Text
  // Meta WhatsApp Cloud API
  whatsappPhoneId     String?
  whatsappToken       String?  @db.Text

  // Twilio WhatsApp
  waProvider          String   @default("meta") // "meta" | "twilio"
  twilioAccountSid    String?
  twilioAuthToken     String?  @db.Text
  twilioPhoneNumber   String?  // e.g. +16204072940
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  selectedProductId   String?
  offlineMessage      String?  @db.Text
  postSaleMessage     String?  @db.Text
  replyDelayMaxSeconds Int      @default(0)
  replyDelayMinSeconds Int      @default(0)
  replyDelayMode       String   @default("instant")
  welcomeMessage      String?  @db.Text
  workEnd             String   @default("18:00")
  workHoursEnabled    Boolean  @default(false)
  workStart           String   @default("09:00")
  verifyToken         String?  @default(uuid())
  voiceReplyEnabled   Boolean  @default(false)

  // ✅ رسائل الطلبيات التلقائية
  orderConfirmMessage   String? @db.Text
  orderShipMessage      String? @db.Text
  orderDeliverMessage   String? @db.Text
  orderCancelledMessage String? @db.Text

  // ✅ رابط التتبع من شركة التوصيل (مثال: https://tracking.company.com/?code={tracking})
  trackingUrlTemplate String? @db.Text

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectionReplies ObjectionReply[]

  @@map("agents")
}

model ObjectionReply {
  id      String @id @default(cuid())
  agentId String
  trigger String
  reply   String @db.Text
  order   Int    @default(0)
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("objection_replies")
}

model Product {
  id          String     @id @default(cuid())
  userId      String
  name        String
  price       Float
  /// Optional sale price. When set and < price, displayed as discount.
  salePrice   Float?
  /// Optional category for grouping/filtering (simple string, no separate model).
  category    String?
  /// JSON array of variant groups: [{ name: "Taille", options: ["S","M","L"] }, ...]
  variants    String?    @db.Text
  /// If false, AI should NOT proactively ask "how many units?" (e.g. phones, furniture).
  /// Customer can still explicitly request multiple.
  askQuantity Boolean    @default(true)
  description String?    @db.Text
  isActive    Boolean    @default(true)
  questions   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  images      String?    @db.Text
  videos      String?    @db.Text
  stock       Int        @default(0)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@map("products")
}

model Conversation {
  id          String            @id @default(cuid())
  userId      String
  customerId  String
  stage       ConversationStage @default(GREETING)
  score       Int               @default(0)
  isRead      Boolean           @default(false)
  totalAmount Float?
  context     Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id])
  messages    Message[]

  @@map("conversations")
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  role              MessageRole
  content           String       @db.Text
  /// معرّف رسالة واتساب الواردة لمنع التكرار عند إعادة webhook
  whatsappMessageId String?      @unique
  /// معرّف ميديا واتساب (صوت/…) — تشغيل مجاني عبر بروكسي بدون Whisper
  whatsappMediaId   String?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Customer {
  id                   String              @id @default(cuid())
  userId               String
  name                 String
  phone                String
  tag                  CustomerTag         @default(NEW)
  totalSpent           Float               @default(0)
  ordersCount          Int                 @default(0)
  lastSeen             DateTime            @default(now())
  marketingOptInAt     DateTime?
  marketingOptInSource String?
  marketingOptOutAt    DateTime?
  outboundBlocked      Boolean             @default(false)
  lastMarketingSentAt  DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations        Conversation[]
  orders               Order[]
  campaignRecipients   CampaignRecipient[]

  @@unique([userId, phone])
  @@map("customers")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum Plan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ConversationStage {
  GREETING
  DISCOVERY
  PITCHING
  OBJECTION
  CLOSING
  CLOSED
  ABANDONED
  ARCHIVED
}

enum MessageRole {
  USER
  AGENT
}

enum CustomerTag {
  NEW
  REGULAR
  VIP
  PROSPECT
}

enum NotificationType {
  NEW_ORDER
  OBJECTION_ALERT
  DAILY_REPORT
  AGENT_DOWN
  SYSTEM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum CampaignAudienceType {
  ALL_BUYERS
  SAME_PRODUCT_BUYERS
  SAME_CATEGORY_BUYERS
  TAG_BUYERS
  RECENT_BUYERS
}

enum CampaignRecipientStatus {
  PENDING
  SKIPPED
  SENT
  FAILED
  REPLIED
  OPTED_OUT
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  customerId     String?
  conversationId String?
  customerName   String
  customerPhone  String
  productId      String?
  productName    String
  /// Selected variant, e.g. "Taille: L / Couleur: Rouge" — populated by AI
  variant        String?
  quantity       Int         @default(1)
  totalAmount    Float
  status         OrderStatus @default(PENDING)
  city           String?
  address        String?     @db.Text
  notes          String?     @db.Text
  confirmSent    Boolean     @default(false)
  shipSent       Boolean     @default(false)
  deliverSent    Boolean     @default(false)
  trackingNumber String?
  deliveryReference String? @unique
  deliveryStatus String?
  sentToDeliveryAt DateTime?
  lastNotifiedDeliveryStatus String?
  deliveryProviderName String?
  isDraft        Boolean     @default(false)
  missingFields  String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer       Customer?   @relation(fields: [customerId], references: [id])

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("orders")
}

model CampaignTemplate {
  id               String     @id @default(cuid())
  userId           String
  name             String
  metaTemplateName String
  language         String     @default("fr")
  headerType       String?
  bodyVariables    Json?
  previewText      String?    @db.Text
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]

  @@unique([userId, metaTemplateName, language])
  @@index([userId, isActive])
  @@map("campaign_templates")
}

model Campaign {
  id                    String               @id @default(cuid())
  userId                String
  productId             String?
  templateId            String?
  name                  String
  status                CampaignStatus       @default(DRAFT)
  audienceType          CampaignAudienceType
  filtersJson           Json?
  templateVariablesJson Json?
  batchSize             Int                  @default(25)
  audienceCount         Int                  @default(0)
  eligibleCount         Int                  @default(0)
  sentCount             Int                  @default(0)
  failedCount           Int                  @default(0)
  skippedCount          Int                  @default(0)
  repliedCount          Int                  @default(0)
  scheduledAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  lastDispatchedAt      DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  product               Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  template              CampaignTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients            CampaignRecipient[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([productId])
  @@index([templateId])
  @@map("campaigns")
}

model CampaignRecipient {
  id            String                  @id @default(cuid())
  campaignId    String
  customerId    String?
  customerName  String?
  phone         String?
  status        CampaignRecipientStatus @default(PENDING)
  skipReason    String?
  variablesJson Json?
  waMessageId   String?
  lastError     String?                 @db.Text
  lastAttemptAt DateTime?
  sentAt        DateTime?
  repliedAt     DateTime?
  optedOutAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  campaign      Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer      Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@index([customerId, status])
  @@map("campaign_recipients")
}

model Invoice {
  id            String        @id @default(cuid())
  clientId      String
  invoiceNumber String        @unique
  amount        Float
  plan          Plan          @default(FREE)
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  paidAt        DateTime?
  notes         String?       @db.Text
  bankInfo      String?       @db.Text
  whatsappSent  Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        User          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model BlogPost {
  id              String         @id @default(cuid())
  authorId        String?
  title           String
  slug            String         @unique
  excerpt         String         @db.Text
  content         String         @db.LongText
  coverImage      String?
  category        String?
  language        String         @default("fr")
  metaTitle       String?
  metaDescription String?        @db.Text
  keywords        String?        @db.Text
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  author          User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([language, status])
  @@index([authorId])
  @@map("blog_posts")
}

